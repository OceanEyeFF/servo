{
  "name": "servo-installer",
  "version": "0.5.8",
  "description": "servo harness installer: install, verify, diagnose, and update CLI + TUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OceanEyeFF/servo"
  },
  "bin": {
    "servo-installer": "toolchain/scripts/deploy/bin/servo-installer.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "product/harness/skills",
    "product/harness/adapters/agents/skills",
    "product/harness/adapters/claude/skills",
    "toolchain/scripts/deploy/README.md",
    "toolchain/scripts/deploy/path_safety_policy.json",
    "toolchain/scripts/deploy/bin/servo-installer.js",
    "toolchain/scripts/deploy/bin/publish-dry-run.js",
    "toolchain/scripts/deploy/bin/check-root-publish.js"
  ],
  "scripts": {
    "smoke": "node toolchain/scripts/deploy/bin/servo-installer.js --help",
    "pack:dry-run": "npm pack --dry-run --json",
    "prepublishOnly": "node toolchain/scripts/deploy/bin/check-root-publish.js",
    "publish:dry-run": "node toolchain/scripts/deploy/bin/publish-dry-run.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "servoInstallerRelease": {
    "realPublishApproval": "approved",
    "approvedVersion": "0.5.8",
    "approvedGitTag": "v0.5.8",
    "approvedChannel": "latest"
  },
  "engines": {
    "node": ">=18"
  }
}
